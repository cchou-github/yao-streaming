# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# tmp folder - keep the folder, ignore its contents
tmp/*
!tmp/.keep

# Terraform - state holds the RDS master password in plaintext (see
# terraform/rds.tf); never commit it, regardless of the "sensitive" marking
# on the output, which only hides it from CLI/plan output, not from state.
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfvars
!terraform/terraform.tfvars.example

# k8s/aws/app.yaml is generated by deploy.sh from app.yaml.template on
# every run, then patched with live terraform output values (RDS
# endpoint, CloudFront domain/key pair ID) - never meant to be
# committed. Same .example-file pattern as terraform.tfvars above.
k8s/aws/app.yaml

# Claude Code's local project settings - machine/session-specific, not
# meant to be shared via the repo.
.claude/settings.json
